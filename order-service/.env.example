PORT=4000

# DB (Prisma usa DATABASE_URL)
DATABASE_URL=postgresql://orders_user:orders_pass@orders-db:5432/orders_db

# Payment provider
PAYMENT_PROVIDER_URL=http://payment-service:8000/api/payments

# Webhook (para más adelante, cuando verifiquemos firmas)
ORDER_WEBHOOK_SECRET=supersecret

JWT_SECRET=super_jwt_secret_change_me
JWT_ISSUER=paymentflow-auth
JWT_EXPIRES_IN=15m